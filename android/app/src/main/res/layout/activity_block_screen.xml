<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sawata_mint_bg"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp">

    <ImageView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/block_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="This app is blocked"
        android:textColor="@color/sawata_red"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/block_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="Sawatâ stepped in before you could open this app."
        android:textColor="@color/sawata_deep_teal"
        android:textSize="15sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="Stay strong — you've got this. If you think this was blocked by mistake, you can manage your blocked list from the Sawatâ app."
        android:textColor="@color/sawata_accent"
        android:textSize="13sp" />

    <Button
        android:id="@+id/back_to_safety_button"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="28dp"
        android:backgroundTint="@color/sawata_deep_teal"
        android:text="Back to Safety"
        android:textAllCaps="false"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
